{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WatchBrief review candidate",
  "type": "object",
  "required": ["id", "status", "detectedAt", "watch"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "issueNumber": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["review", "needs-review", "approved", "published", "rejected", "duplicate"] },
    "detectedAt": { "type": "string", "format": "date" },
    "reviewedAt": { "type": "string", "format": "date" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "watch": {
      "type": "object",
      "required": ["id", "slug", "brand", "brandSlug", "model", "date", "lugToLug", "limitedEdition", "verified", "verificationStatus", "editorialStatus", "independent"],
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "brand": { "type": "string", "minLength": 1 },
        "brandSlug": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "lugToLug": { "type": "string", "minLength": 1 },
        "price": { "type": "string" },
        "priceSourceUrl": { "type": "string", "format": "uri" },
        "priceCheckedAt": { "type": "string", "format": "date" },
        "priceMarket": { "type": "string" },
        "priceTaxMode": { "enum": ["incl-vat", "excl-vat", "unknown"] },
        "limitedEdition": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 900 },
        "productUrl": { "type": "string", "format": "uri" },
        "imageUrl": { "type": "string", "format": "uri" },
        "imageSourceUrl": { "type": "string", "format": "uri" },
        "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "verified": { "type": "boolean" },
        "verificationStatus": { "enum": ["seed", "verified", "needs-review"] },
        "editorialStatus": { "enum": ["backlog", "researching", "publishable", "broken-link"] },
        "independent": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
